# npm registry pinned at project level: `npm config get registry` inside this
# directory must return https://registry.npmjs.org/, and lockfiles cannot drift
# to another registry (enforced pre-install by
# scripts/check-lockfile-registry.mjs in all three frontend CI jobs).
registry=https://registry.npmjs.org/

# Electron / electron-builder binaries: production artifacts are built from
# official sources. Mirroring for restricted networks MUST NOT be committed
# here or in electron-builder.yml; the mechanism differs per electron-builder
# major (v26: electronDownload.mirror config; v27+: electronGet.mirrorOptions),
# and several legacy environment variables (including
# ELECTRON_BUILDER_BINARIES_MIRROR) were removed upstream — re-check the
# official environment-variable documentation at each major upgrade instead of
# relying on any fixed variable name. Previous committed npmmirror mirror keys
# were removed (they also triggered npm "Unknown project config" warnings).
