# Copy to .env and fill locally. Never commit .env.
GCMW_ENV=development
GCMW_DEBUG=0
GCMW_ACTIVE_PROVIDER=mock

# Cloud provider (development/test only; must not receive real patient data)
GCMW_CLOUD_PROVIDER=dashscope_realtime
GCMW_CLOUD_ADAPTER=cloud_realtime
GCMW_CLOUD_MODEL=qwen3.5-omni-plus-realtime
GCMW_CLOUD_API_BASE=https://dashscope.aliyuncs.com/api/v1
# GCMW_CLOUD_API_KEY=set-via-secret-manager

# Local Omni provider
GCMW_LOCAL_PROVIDER=vllm
GCMW_LOCAL_ADAPTER=local_omni
GCMW_LOCAL_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
GCMW_LOCAL_API_BASE=http://127.0.0.1:8001/v1

# Storage
GCMW_REDIS_URL=redis://127.0.0.1:6379/0
GCMW_DATABASE_URL=postgresql://gcmw:gcmw@127.0.0.1:5432/gcmw
GCMW_VECTOR_DATABASE_URL=

# Run limits
GCMW_RUN_TIMEOUT_MS=15000
GCMW_ANSWER_TOKEN_BUDGET=400
GCMW_MAX_TOOL_CALLS=4
GCMW_MAX_AGENT_HANDOFFS=2
GCMW_MAX_REVISIONS=1
